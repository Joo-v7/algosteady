<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />
    <include resource="org/springframework/boot/logging/logback/console-appender.xml" />

    <springProperty name="APPLICATION_NAME" source="spring.application.name" defaultValue="algosteady" />
    <springProperty name="INSTANCE_NAME" source="algosteady.instance-name" defaultValue="default" />
    <springProperty name="RELEASE_VERSION" source="algosteady.release-version" defaultValue="local" />
    <springProperty name="LOG_DIRECTORY" source="logging.file.path" defaultValue="logs" />

    <!-- 파일 로그 형식 -->
    <property name="APPLICATION_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS,Asia/Seoul} %-5level [${APPLICATION_NAME}:${INSTANCE_NAME}] [version=${RELEASE_VERSION}] [%thread] %logger{36} - %msg%n%ex" />

    <!-- 로컬 콘솔 출력 -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <springProfile name="prod">
        <!-- 운영 전체 로그 -->
        <appender name="APPLICATION_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIRECTORY}/${INSTANCE_NAME}/application.log</file>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${APPLICATION_LOG_PATTERN}</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIRECTORY}/${INSTANCE_NAME}/archive/application.%d{yyyy-MM-dd,Asia/Seoul}.%i.log.gz</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
                <cleanHistoryOnStart>true</cleanHistoryOnStart>
            </rollingPolicy>
        </appender>

        <!-- 운영 오류 로그 -->
        <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIRECTORY}/${INSTANCE_NAME}/error.log</file>
            <filter class="ch.qos.logback.classic.filter.LevelFilter">
                <level>ERROR</level>
                <onMatch>ACCEPT</onMatch>
                <onMismatch>DENY</onMismatch>
            </filter>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>${APPLICATION_LOG_PATTERN}</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIRECTORY}/${INSTANCE_NAME}/archive/error.%d{yyyy-MM-dd,Asia/Seoul}.%i.log.gz</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>256MB</totalSizeCap>
                <cleanHistoryOnStart>true</cleanHistoryOnStart>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="APPLICATION_FILE" />
            <appender-ref ref="ERROR_FILE" />
        </root>
    </springProfile>
</configuration>
