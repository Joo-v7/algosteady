  "contract": {
    "storage": "array",
    "capacity": 50,
    "scope": "제공된 GraphType을 사용해 dfs_mat 함수의 정의와 본문 전체를 구현합니다. 그래프 생성 함수은 제공되며 visited는 호출 코드가 관리합니다.",
    "functions": [
      {
        "name": "dfs_mat",
        "signature": "void dfs_mat(GraphType *g, int v)",
        "behavior": "유효한 미방문 시작 정점 v를 방문 표시하고 \"%d \"로 출력한 뒤, 번호가 작은 미방문 이웃부터 재귀 순회합니다. 연결되지 않은 정점·기존 방문 표시·그래프 구조는 보존합니다."
      }
    ],
    "requirements": [
      "무방향·비가중치 단순 그래프이며 정점은 0~n-1, 최대 50개입니다. 자기 간선은 허용하지 않습니다.",
      "중복 간선은 새로 추가하지 않습니다.",
      "순회 시작점은 유효하고 미방문인 정점입니다. 연결되지 않은 정점은 방문하지 않습니다.",
      "이웃 번호를 0부터 n-1까지 확인합니다. 각 정점은 처음 방문할 때 \"%d \"로 출력하며 마지막 줄바꿈은 호출 코드가 출력합니다."
    ]
  },
  "prerequisites": [
    "graph-matrix",
    "recursion-factorial"
  ],
  "criteria": [
    {
      "id": "single",
      "order": 1,
      "title": "고립 정점",
      "description": "시작 정점 하나를 방문합니다."
    },
    {
      "id": "order",
      "order": 2,
      "title": "방문 순서",
      "description": "번호가 작은 이웃부터 정해진 순서로 방문합니다."
    },
    {
      "id": "cycles",
      "order": 3,
      "title": "사이클·중복 경로",
      "description": "같은 정점을 두 번 방문하지 않습니다."
    },
    {
      "id": "disconnected",
      "order": 4,
      "title": "연결 요소",
      "description": "시작 정점과 연결된 부분만 순회합니다."
    },
    {
      "id": "visited",
      "order": 5,
      "title": "방문 상태",
      "description": "이전 방문 표시를 보존하고 연결된 정점을 표시합니다."
    },
    {
      "id": "boundary",
      "order": 6,
      "title": "최대 크기",
      "description": "50개 정점을 빠짐없이 순회합니다."
    },
    {
      "id": "preservation",
      "order": 7,
      "title": "그래프 보존·반복 호출",
      "description": "그래프를 변경하지 않고 여러 시작점에서 순회합니다."
    }
  ],
  "languages": {
    "c": {
      "standard": "c17",
      "starter": "c/starter.c",
      "reference": "c/reference.c",
      "harness": "c/harness.c",
