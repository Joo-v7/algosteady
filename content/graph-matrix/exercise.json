    {
      "id": "vertices",
      "order": 2,
      "title": "정점 추가",
      "description": "정점을 순서대로 추가합니다."
    },
    {
      "id": "edges",
      "order": 3,
      "title": "양방향 연결",
      "description": "간선을 양쪽에 저장합니다."
    },
    {
      "id": "duplicates",
      "order": 4,
      "title": "중복 간선",
      "description": "같은 간선을 다시 추가해도 중복되지 않습니다."
    },
    {
      "id": "errors",
      "order": 5,
      "title": "범위·포화 처리",
      "description": "잘못된 정점·자기 간선·정점 수 초과를 오류 종료합니다."
    },
    {
      "id": "boundary",
      "order": 6,
      "title": "최대 크기",
      "description": "50개 정점의 경계와 많은 간선을 처리합니다."
    },
    {
      "id": "reuse",
      "order": 7,
      "title": "초기화·독립성",
      "description": "다시 초기화하거나 두 그래프를 독립적으로 사용합니다."
    }
  ],
