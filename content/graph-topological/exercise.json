    },
    {
      "id": "relations",
      "order": 2,
      "title": "선후 관계",
      "description": "모든 간선의 출발 정점이 도착 정점보다 먼저 오도록 정렬합니다."
    },
    {
      "id": "components",
      "order": 3,
      "title": "복수 시작점·연결 요소",
      "description": "여러 시작 정점과 고립 정점도 빠짐없이 처리합니다."
    },
    {
      "id": "cycles",
      "order": 4,
      "title": "사이클 판정",
      "description": "일부라도 처리하지 못한 정점이 남으면 -1을 반환합니다."
    },
    {
      "id": "boundary",
      "order": 5,
      "title": "최대 크기",
      "description": "최대 50개 정점과 조밀한 그래프를 처리합니다."
    },
    {
      "id": "repeat",
      "order": 6,
      "title": "반복 호출·그래프 보존",
      "description": "이전 상태를 초기화하고 원본 그래프를 보존합니다."
    }
  ],
